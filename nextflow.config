docker.enabled = true

process {
    executor = "local"
    cpus = 2
    memory = "6 GB"
    errorStrategy = "terminate"
}

timeline {
    enabled = true
    file = "pipeline_info/timeline.html"
}

report {
    enabled = true
    file = "pipeline_info/report.html"
}

trace {
    enabled = true
    file = "pipeline_info/trace.txt"
}

dag {
    enabled = true
    file = "pipeline_info/flowchart.html"
}
